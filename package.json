{
  "name": "twilight-struggle-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "npm run start -w @ts/server",
    "dev": "concurrently -k -n web,server \"npm run dev -w @ts/web\" \"npm run dev -w @ts/server\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test packages/game-core/test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "assets:import": "node tools/import-tts-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1", "@types/node": "26.6.5", "concurrently": "10.0.6",
    "eslint": "10.13.0", "typescript-eslint": "8.71.2", "typescript": "6.0.3", "tsx": "4.23.15"
  }
}
